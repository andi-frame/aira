---
interface Props {
  name: 'accessibility' | 'voice' | 'form' | 'summary' | 'contrast' | 'shield' | 'download' | 'arrow' | 'play' | 'check' | 'spark';
  size?: number;
  stroke?: number;
}

const { name, size = 22, stroke = 1.9 } = Astro.props;
---

<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'accessibility' && <>
    <circle cx="12" cy="4" r="1.6" />
    <path d="M5 8.3c2.2 1 4.5 1.5 7 1.5s4.8-.5 7-1.5" />
    <path d="M12 10v9" />
    <path d="m8 21 4-5 4 5" />
    <path d="m8.2 10-1.7 5M15.8 10l1.7 5" />
  </>}
  {name === 'voice' && <>
    <rect x="8.5" y="3" width="7" height="12" rx="3.5" />
    <path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3M8.5 21h7" />
  </>}
  {name === 'form' && <>
    <rect x="4" y="3.5" width="16" height="17" rx="2.5" />
    <path d="M8 8h8M8 12h8M8 16h4" />
    <path d="m15.8 15.6 1.3 1.3 2.8-3" />
  </>}
  {name === 'summary' && <>
    <path d="M5 5.5h14M5 10h10M5 14.5h14M5 19h7" />
    <path d="m17 9 2 2 3-3" />
  </>}
  {name === 'contrast' && <>
    <circle cx="12" cy="12" r="8.5" />
    <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" stroke="none" />
  </>}
  {name === 'shield' && <>
    <path d="M12 3 19 6v5c0 4.5-2.9 7.9-7 10-4.1-2.1-7-5.5-7-10V6z" />
    <path d="m8.5 12 2.2 2.2 4.8-4.8" />
  </>}
  {name === 'download' && <>
    <path d="M12 3v12" />
    <path d="m7 10 5 5 5-5M5 20h14" />
  </>}
  {name === 'arrow' && <path d="M5 12h13M13 6l6 6-6 6" />}
  {name === 'play' && <path d="m9 6 9 6-9 6z" fill="currentColor" stroke="none" />}
  {name === 'check' && <path d="m5 12 4.5 4.5L19 7" />}
  {name === 'spark' && <>
    <path d="m12 2 1.2 5.1L18 9l-4.8 1.9L12 16l-1.2-5.1L6 9l4.8-1.9z" />
    <path d="m19 15 .6 2.4L22 18l-2.4.6L19 21l-.6-2.4L16 18l2.4-.6z" />
  </>}
</svg>
