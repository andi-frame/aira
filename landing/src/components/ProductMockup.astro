---
import Icon from './Icon.astro';
---

<div class="product-stage" aria-label="Ilustrasi antarmuka AIRA di atas portal layanan publik" role="img">
  <div class="glow glow-one"></div>
  <div class="glow glow-two"></div>
  <div class="mock-browser">
    <div class="mock-chrome">
      <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="address-bar"><span class="lock-dot">⌁</span> layanan-publik.go.id / pendaftaran</div>
      <span class="mock-status">AIRA aktif</span>
    </div>
    <div class="mock-body">
      <div class="mock-page">
        <div class="mock-site-nav"><span class="mock-site-logo">Layanan Publik</span><span class="mock-site-link"></span><span class="mock-site-link short"></span></div>
        <div class="mock-breadcrumb">Beranda / Pendaftaran layanan</div>
        <div class="mock-title-line wide"></div>
        <div class="mock-title-line"></div>
        <div class="mock-copy-line"></div>
        <div class="mock-copy-line short"></div>
        <div class="mock-form-card">
          <span class="mock-label">Formulir pendaftaran</span>
          <div class="mock-input active"><span>Nama lengkap</span><b>Andi Hidayat</b></div>
          <div class="mock-input"><span>Nomor identitas</span><b></b></div>
          <div class="mock-input"><span>Nomor WhatsApp</span><b></b></div>
          <div class="mock-button"></div>
        </div>
      </div>
      <aside class="mock-panel">
        <div class="mock-panel-top"><span class="mini-brand"><i></i><i></i><i></i></span><strong>AIRA</strong><span class="live-dot">● LIVE</span></div>
        <div class="mock-panel-kicker">PANDUAN FORMULIR</div>
        <div class="mock-progress"><span></span></div>
        <div class="mock-step">Langkah 2 dari 5 <b>40%</b></div>
        <div class="mock-question">Apa nomor identitas<br />yang ingin digunakan?</div>
        <div class="mock-hint">AIRA menjelaskan istilah rumit dengan bahasa yang lebih mudah.</div>
        <div class="mock-answer">16 digit angka pada KTP <span>✓</span></div>
        <div class="mock-voice"><span class="voice-circle"><Icon name="voice" size={16} /></span><span><b>Tekan untuk bicara</b><small>Alt + S untuk push to talk</small></span></div>
        <div class="mock-actions"><span>Kembali</span><strong>Lanjut <Icon name="arrow" size={14} /></strong></div>
      </aside>
    </div>
  </div>
  <div class="mock-badge badge-top"><Icon name="accessibility" size={16} /> Aksesibel by design</div>
  <div class="mock-badge badge-bottom"><span class="badge-check"><Icon name="check" size={13} /></span> Data tervalidasi lokal</div>
</div>
