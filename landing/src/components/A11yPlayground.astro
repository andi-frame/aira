---
import BrowserMockup from './BrowserMockup.astro';
import AiraDockedPanel from './AiraDockedPanel.astro';
---

<section class="a11y-section">
  <div class="container">
    <h2 class="a11y-heading">
      Bagi <em>A</em>IRA, <span class="brand-highlight">aksesibilitas</span> bukanlah aksesoris.
    </h2>
    <p class="a11y-subtitle">Rasakan kemudahan yang ditawarkan <em>A</em>IRA.</p>

    <BrowserMockup>
      <AiraDockedPanel />
    </BrowserMockup>
  </div>
</section>

<script>
  // Text scale stepper (mutates the simulated host page)
  const textScales = [
    { label: '100%', val: 1.0 },
    { label: '115%', val: 1.15 },
    { label: '130%', val: 1.3 },
    { label: '150%', val: 1.5 }
  ];
  const lineSpacings = [
    { label: '100%', val: 1.5 },
    { label: '125%', val: 1.85 },
    { label: '150%', val: 2.2 },
    { label: '175%', val: 2.55 }
  ];

  let textScaleIndex = 0;
  let lineSpacingIndex = 0;

  const host = document.getElementById('bpjsPortal');
  const textDisplay = document.getElementById('textScaleDisplay');
  const lineDisplay = document.getElementById('lineSpacingDisplay');

  document.querySelectorAll<HTMLButtonElement>('.aira-stepper-btn[data-step]').forEach((button) => {
    button.addEventListener('click', () => {
      const direction = Number(button.dataset.dir || '1');
      if (button.dataset.step === 'text') {
        textScaleIndex = Math.min(textScales.length - 1, Math.max(0, textScaleIndex + direction));
        const scale = textScales[textScaleIndex];
        host?.style.setProperty('--bpjs-scale', String(scale.val));
        if (textDisplay) textDisplay.textContent = scale.label;
      } else {
        lineSpacingIndex = Math.min(lineSpacings.length - 1, Math.max(0, lineSpacingIndex + direction));
        const spacing = lineSpacings[lineSpacingIndex];
        host?.style.setProperty('--bpjs-lh', String(spacing.val));
        if (lineDisplay) lineDisplay.textContent = spacing.label;
      }
    });
  });

  // Guide actions: highlight the matching element on the simulated host page
  const pulse = (element: HTMLElement | null) => {
    if (!element) return;
    element.classList.add('highlight-pulse');
    element.scrollIntoView({
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      block: 'center'
    });
    window.setTimeout(() => element.classList.remove('highlight-pulse'), 2500);
  };

  const runGuide = (guide: string) => {
    if (guide === 'form') {
      const input = document.getElementById('bpjsNikInput');
      input?.focus();
      pulse(input);
    } else if (guide === 'nav') {
      pulse(document.getElementById('bpjsNavMenu'));
    }
  };

  document.querySelectorAll<HTMLElement>('.aira-interactive-card[data-guide]').forEach((card) => {
    card.addEventListener('click', () => runGuide(card.dataset.guide || ''));
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        runGuide(card.dataset.guide || '');
      }
    });
  });
</script>
