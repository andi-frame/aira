{
  "name": "aira-extension",
  "version": "1.0.0",
  "description": "AIRA - Adaptive Interface and Responsive Assistance for Web Navigation and Form Completion (IFEST 2026)",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run --watch build.ts",
    "typecheck": "tsc --noEmit",
    "package:extension": "bun run scripts/package_extension.ts",
    "site:prepare": "bun run scripts/prepare_site.ts",
    "site:build": "bun run scripts/site_build.ts",
    "site:deploy": "bun run scripts/site_deploy.ts",
    "deploy": "bun run site:deploy",
    "wrangler": "wrangler"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.6.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.134.0"
  }
}
