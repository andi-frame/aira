# =====================================================================
# AIRA Agent-Loop .gitignore
# =====================================================================

# Environment variables & Secrets
.env
.env.*
*.env
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/

# Test & coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Build & packaging artifacts
dist/
build/
*.egg-info/

# Logs & temp
*.log
tmp/
scratch/