# =====================================================================
# AIRA AGENT CONFIGURATION
# =====================================================================

# Opsi 1: Menggunakan 9Router (Local AI Gateway / OpenAI-Compatible)
# Anda bisa menulis http://localhost:20128/v1 atau langsung http://localhost:20128/v1/chat/completions
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=9router
ROUTER_MODEL=gemini-2.5-flash

# Opsi 2: Direct Google Gemini API (Fallback jika tidak pakai 9Router)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Observability LangSmith (Opsional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=aira-ifest-2026

# Server Settings
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
