# =====================================================================
# AIRA AGENT CONFIGURATION
# =====================================================================

# Opsi 1: Menggunakan 9Router (Gateway LLM & STT Whisper)
# Base URL & API Key ini otomatis digunakan untuk:
#   - Chat LLM: {ROUTER_BASE_URL}/chat/completions
#   - Audio STT: {ROUTER_BASE_URL}/audio/transcriptions
# Contoh remote: https://9r.disra.net/v1 | Contoh local: http://localhost:20128/v1
ROUTER_BASE_URL=https://9r.disra.net/v1
ROUTER_API_KEY=9router
ROUTER_MODEL=cx/gpt-5.6-luna
ROUTER_STT_MODEL=whisper-1

# Opsi 2: Direct Google Gemini API (Fallback jika tidak pakai 9Router)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Observability LangSmith (Opsional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=aira-ifest-2026

# Server Settings
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
